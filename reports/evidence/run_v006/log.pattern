LAMMPS (2 Apr 2025 - Development - patch_2Apr2025-256-g165f34bc12)
# =============================================================================
# in.pattern 模板（人类维护，Agent 只允许替换双下划线占位符，禁止改动物理内容）
# 渲染后每个 seed 目录中的 in.pattern 为独立、自包含的输入脚本。
# 路径铁律：脚本内只出现相对路径（../），禁止绝对路径与非 ASCII 字符。
# 单位制：metal (eV, Angstrom, ps, K)
# =============================================================================
units metal
atom_style atomic
boundary p p p

read_data ../structure.data
Reading data file ...
  orthogonal box = (0 0 -72.525) to (20.65 35.766849 75.562526)
  1 by 2 by 12 MPI processor grid
  reading atoms ...
  6132 atoms
  read_data CPU = 0.009 seconds
print "GEOM lx=$(lx) ly=$(ly) lz=$(lz) xlo=$(xlo) ylo=$(ylo) zlo=$(zlo)"
GEOM lx=20.649999999999998579 ly=35.766849000000000558 lz=148.08752600000002531 xlo=0 ylo=0 zlo=-72.525000000000005684

# --- 势函数：人类维护、哈希锁定；Agent 禁止编辑 -------------------------------
include ../potentials.in
# Si/Ti/Cu/Ti/Si anchor potential: NEP89 (universal NEP, 89 elements).
# Model: potentials/nep89.txt  (download with tools/get_nep89.sh, 14 MB)
# Element mapping follows the LAMMPS atom types in this project: 1=Si 2=Ti 3=Cu
pair_style nep
pair_coeff * * ../../../potentials/CuTiC_NEP.txt C Ti Cu
# -----------------------------------------------------------------------------

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# --- 热源 / 热汇区域：所有 z 坐标来自 geom.json，禁止写死 ----------------------
region hot_region  block INF INF INF INF -49.525000 -39.721000 units box
region cold_region block INF INF INF INF 53.640541 60.562526 units box
group hot_g  region hot_region
392 atoms in group hot_g
group cold_g region cold_region
512 atoms in group cold_g
variable hot_n  equal count(hot_g)
variable cold_n equal count(cold_g)
print "COUNTS hot=${hot_n} cold=${cold_n}"
COUNTS hot=392 cold=512

# --- 结构最小化（强制配置，禁止 Agent 修改）-----------------------------------
min_style cg
min_modify dmax 0.05
minimize 1e-6 1e-8 10000 100000
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
